# ============================================================
# Docker Compose Environment Variables
# ============================================================
# Copy this file to .env and fill in production values:
#   cp .env.docker.example .env
#
# NEVER commit .env to version control!
# ============================================================

# ---- Database ----
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=oa_system
DB_USER=oa_user
DB_PASSWORD=change_me_db_password

# Full MySQL connection URL for Prisma
# IMPORTANT: Replace the password below with the same value as DB_PASSWORD
DATABASE_URL=mysql://oa_user:CHANGE_ME@mysql:3306/oa_system

# ---- Backend Security ----
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=24h
COOKIE_SECRET=change_me_cookie_secret_at_least_32_chars

# ---- URLs ----
# The URL users use to access the app (for CORS / cookie domain)
FRONTEND_URL=http://localhost

# ---- Host Port ----
# Port exposed on the host machine (default: 80)
HOST_PORT=80
