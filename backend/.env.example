# Database
DATABASE_URL="postgresql://user:password@localhost:5432/enterprise_mgmt"

# JWT
# REQUIRED in production. Must be a long, random string.
JWT_SECRET="your-jwt-secret-here"
JWT_EXPIRES_IN="24h"

# Cookies
# REQUIRED in production. Must be a long, random string.
COOKIE_SECRET="your-cookie-secret-here"

# Server
PORT=3000
NODE_ENV=development

# Frontend
FRONTEND_URL="http://localhost:5173"
