# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# Database (MySQL)
# Format: mysql://USER:***@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:***@localhost:3306/oa_system"

# JWT
# REQUIRED in production. Must be a long, random string (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-jwt-secret-here"

# JWT expiry duration (e.g. 24h, 7d)
JWT_EXPIRES_IN="24h"

# Cookies
# REQUIRED in production. Must be a long, random string (min 32 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET="your-cookie-secret-here"

# Server
PORT=3000
# Set to "production" for deployed environments
NODE_ENV=development

# Frontend
# In production, set to your actual frontend domain (e.g. https://app.example.com)
FRONTEND_URL="http://localhost:5173"

# =============================================================================
# Production Notes:
# - All secrets (JWT_SECRET, COOKIE_SECRET) MUST be replaced with strong random
#   values before deploying. Never use the defaults in production.
# - NODE_ENV should be set to "production" to enable stricter error handling.
# - DATABASE_URL should point to your production MySQL instance.
# - FRONTEND_URL must match your deployed frontend origin exactly.
# =============================================================================
